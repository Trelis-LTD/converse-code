{
  "name": "@trelis/converse",
  "version": "0.8.0",
  "type": "module",
  "description": "Browser SDK for the Trelis Converse v2.1 WebSocket voice API",
  "license": "Apache-2.0",
  "keywords": [
    "voice",
    "voice-ai",
    "realtime",
    "speech",
    "converse"
  ],
  "homepage": "https://converse.trelis.com/docs/api/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Trelis-LTD/voice-loop-pro.git",
    "directory": "sdk/browser"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_LICENSES"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "pack:check": "npm pack --dry-run",
    "vendor": "node scripts/vendor.mjs",
    "vendor:check": "node scripts/vendor.mjs --check"
  },
  "sideEffects": false
}
